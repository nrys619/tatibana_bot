# ============================================================
# 立花証券 e支店 API 認証情報
# ============================================================
# 【推奨】公開鍵認証 (v4r9〜)
# 立花証券の会員ページで鍵ペアを発行すると以下のファイルが得られる:
#   e_api_authid.txt        認証ID
#   e_api_private_key.pem   秘密鍵 (これを使う。絶対に共有・コミットしない)
#   e_api_public_key.pem/.der 公開鍵 (立花側に登録済み。ログインには不要)
# ファイルは本リポジトリ外か secrets/ (gitignore済み) に置くこと。
# ※ デモ環境と本番環境で認証ID・鍵ペアは別物。
TACHIBANA_AUTH_ID_FILE=secrets/e_api_authid.txt
TACHIBANA_PRIVATE_KEY_FILE=secrets/e_api_private_key.pem
# (ファイルではなく認証ID文字列を直接渡す場合)
# TACHIBANA_AUTH_ID=xxxxxxxx

# 【旧方式】パスワード認証 (v4r8以前, config: api.auth_method: password)
# TACHIBANA_USER_ID=your_user_id
# TACHIBANA_PASSWORD=your_password

# Anthropic API (開示情報のLLM解析に使用)
ANTHROPIC_API_KEY=sk-ant-...
TACHIBANA_SECOND_PASSWORD=
