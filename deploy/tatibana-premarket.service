[Unit]
Description=朝のニュース解析
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tatibana
WorkingDirectory=/home/tatibana/tatibana_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tatibana/tatibana_bot/.venv/bin/python scripts/premarket.py
StandardOutput=append:/home/tatibana/tatibana_bot/logs/launchd_premarket.log
StandardError=append:/home/tatibana/tatibana_bot/logs/launchd_premarket.log
