[Unit]
Description=スイング戦略 (日足で数日保有。デイトレとは別建て)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tatibana
WorkingDirectory=/home/tatibana/tatibana_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tatibana/tatibana_bot/.venv/bin/python scripts/swing_daily.py
StandardOutput=append:/home/tatibana/tatibana_bot/logs/swing.log
StandardError=append:/home/tatibana/tatibana_bot/logs/swing.log
