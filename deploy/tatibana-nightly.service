[Unit]
Description=夜の銘柄選定とモデル学習
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tatibana
WorkingDirectory=/home/tatibana/tatibana_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tatibana/tatibana_bot/.venv/bin/python scripts/nightly.py
StandardOutput=append:/home/tatibana/tatibana_bot/logs/launchd_nightly.log
StandardError=append:/home/tatibana/tatibana_bot/logs/launchd_nightly.log
