[Unit]
Description=板録画の圧縮 (ディスク保護)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tatibana
WorkingDirectory=/home/tatibana/tatibana_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tatibana/tatibana_bot/.venv/bin/python scripts/compress_snapshots.py
StandardOutput=append:/home/tatibana/tatibana_bot/logs/compress.log
StandardError=append:/home/tatibana/tatibana_bot/logs/compress.log
